    "@angular/router": "^21.1.0",
    "@fontsource/poppins": "^5.2.7",
    "bootstrap": "^5.3.8",
    "highlight.js": "^11.11.1",
    "highlightjs-line-numbers.js": "^2.9.1",
    "js-beautify": "^1.15.4",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.0",
